  "sections": [
    {"label": "GROOVE", "keys": ["pattern", "root", "octave", "key_follow", "lock", "gap", "sync", "bpm"]},
    {"label": "KICK",   "keys": ["kick_pitch", "kick_sweep", "kick_decay", "kick_click", "kick_drive", "kick_level"]},
